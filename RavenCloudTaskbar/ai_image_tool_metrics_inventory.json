  "aggregation": "PARTITIONED_BY_EVIDENCE_STATE_NO_CROSS_LANE_TOTAL",
  "release_gate": "VERIFIED_RELEASE_REQUIRES_AVAILABILITY_RECEIPT",
  "runtime_gate": "RELEASE_AVAILABILITY_DOES_NOT_ESTABLISH_RUNTIME_VERIFICATION",
  "automation": "NONE",
