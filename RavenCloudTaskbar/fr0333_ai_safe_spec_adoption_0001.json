  "adopted_spec_patterns": [
    {"reference_point":"A1","pattern":"PUBLIC.SPEC.ONLY","value":"T.20.PASS","source":"SRC.001","meaning":"Adopt concepts from public documentation without entering third-party provider systems."},
    {"reference_point":"B2","pattern":"GOVERN.MAP.MEASURE.MANAGE","value":"ADOPT","source":"SRC.001","meaning":"Risk management remains continuous across the lifecycle rather than a one-time safety check."},
    {"reference_point":"C3","pattern":"TEVV.CONTINUOUS","value":"ADOPT","source":"SRC.001","meaning":"Testing evaluation verification and validation occur before deployment and during operation."},
    {"reference_point":"D4","pattern":"CAPABILITY.THRESHOLD.ESCALATES.SAFEGUARDS","value":"ADOPT","source":"SRC.004","meaning":"More capable systems require proportionally stronger safeguards rather than weaker controls."},
    {"reference_point":"E5","pattern":"LAYERED.SAFEGUARDS","value":"ADOPT","source":"SRC.003","meaning":"No single control is treated as sufficient against severe misuse or failure."},
    {"reference_point":"F6","pattern":"OPERATOR.SHUTDOWN.MUST.REMAIN.POSSIBLE","value":"ADOPT","source":"SRC.005","meaning":"System evolution must preserve operator ability to direct modify or stop operation."},
    {"reference_point":"G7","pattern":"IDENTITY.BOUND.ACTIONS","value":"ADOPT","source":"SRC.006","meaning":"Actions should be attributable to the authorized human identity rather than an unbounded service identity."},
    {"reference_point":"H8","pattern":"LEAST.PRIVILEGE.SCOPED.PERMISSIONS","value":"ADOPT","source":"SRC.006","meaning":"Agent tools inherit bounded permissions and cannot silently exceed operator authorization."},
    {"reference_point":"I9","pattern":"MUTATION.REQUIRES.CONSENT","value":"ADOPT","source":"SRC.006","meaning":"Mutating actions require explicit user consent or a clearly scoped prior authorization."},
    {"reference_point":"J10","pattern":"AUDIT.LOG.ATTRIBUTION","value":"ADOPT","source":"SRC.006","meaning":"Actions retain who what when where attribution sufficient for investigation and accountability."},
    {"reference_point":"K11","pattern":"ONTOLOGY.SEPARATES.DATA.LOGIC.ACTION","value":"ADOPT.CONCEPT","source":"SRC.008","meaning":"Keep data logic and operational action explicitly mapped rather than blending them into opaque model behavior."},
    {"reference_point":"L12","pattern":"CONTINUOUS.DEPLOYMENT.WITH.CONTROL.PLANE","value":"ADOPT.CONCEPT","source":"SRC.008","meaning":"Updates should pass through a controlled deployment layer with configuration and rollback discipline."},
    {"reference_point":"M13","pattern":"EXTERNAL.REVIEW.WHEN.RISK.RISES","value":"ADOPT","source":"SRC.004","meaning":"Independent or external review becomes more important as capability and risk rise."},
    {"reference_point":"N14","pattern":"FAILURE.MEMORY.APPEND.ONLY","value":"RETAIN","source":"LOCAL.CONTROL","meaning":"New capability never deletes prior hallucination failure contradiction or runtime-fault evidence."},
    {"reference_point":"O15","pattern":"AUTONOMOUS.SELF.MODIFICATION","value":"F.6.REJECT","source":"LOCAL.CONTROL","meaning":"No runtime instance may silently rewrite its own base weights or replace governing controls."},
    {"reference_point":"P16","pattern":"HUMAN.OPERATOR.CONTINUITY","value":"T.20.ACTIVE","source":"LOCAL.CONTROL","meaning":"The collaborative human operator remains the authority anchor for intent promotion and canonical changes; evolution must not erase the human relationship from the architecture."}
