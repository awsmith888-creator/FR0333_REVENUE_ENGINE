      "intent_hash",
      "scene_contract",
      "reference_policy",
      "input_reference_ids",
      "output_asset_id",
      "width",
      "height",
      "aspect_ratio",
      "provider_request_id",
      "visual_fingerprint",
      "readback_state",
      "user_state"
