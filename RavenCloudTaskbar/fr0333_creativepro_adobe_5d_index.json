{
  "identifier": "FR0333.CREATIVEPRO.ADOBE.5D.HARDENER.001",
  "version": "1.0.0",
  "state": "INDEXED_SPEC_ACTIVE",
  "purpose": "Use CreativePro as a professional secondary-source network to harden the Adobe/FR-0333 production system without promoting secondary claims to primary authority.",
  "governing_gates": [
    "100_PERCENT_MEANS_REQUIRED_LANE_COVERAGE_NOT_INFALLIBILITY",
    "PRIMARY_SOURCE_GT_PROFESSIONAL_SECONDARY_GT_GENERAL_COMMENTARY",
    "FOLLOWER_COUNT_NE_TECHNICAL_AUTHORITY",
    "SOURCE_COUNT_NE_INDEPENDENT_SOURCE_COUNT",
    "METADATA_NE_PROVENANCE_NE_AUTHENTICITY_NE_IDENTITY_NE_TRUTH",
    "ACCESS_NE_AUTHORITY",
    "MISSING_NE_ZERO",
    "HOLD_NE_PASS",
    "OBSERVED_NE_CORRELATED_NE_CAUSAL"
  ],
  "five_dimensions": {
    "D1_SOURCE_AUTHORITY": {
      "function": "Rank and verify source authority before promotion.",
      "required_controls": [
        "source_class",
        "primary_source_check",
        "secondary_source_label",
        "claim_date",
        "source_url",
        "source_independence",
        "conflict_detection",
        "promotion_state"
      ]
    },
    "D2_PRODUCTION_WORKFLOW": {
      "function": "Measure end-to-end creative production coverage.",
      "required_controls": [
        "create",
        "edit",
        "automate",
        "accessibility",
        "proof",
        "publish",
        "master_delivery_separation",
        "reproducibility"
      ]
    },
    "D3_FORENSICS_RIGHTS": {
      "function": "Harden provenance, rights, lineage, and synthetic-image evidence.",
      "required_controls": [
        "source_lock",
        "original_derivative_published_split",
        "c2pa_signal",
        "metadata_nontruth_rule",
        "rights_state",
        "regional_inspection",
        "defect_vector",
        "forensic_clear"
      ]
    },
    "D4_ATTENTION_NETWORK": {
      "function": "Measure scale without converting popularity into authority.",
      "required_controls": [
        "historical_reach",
        "current_membership",
        "community_reach",
        "event_audience",
        "partner_network",
        "channel_count",
        "unique_people_deduplication",
        "time_window_normalization"
      ]
    },
    "D5_ECONOMIC_RUNTIME": {
      "function": "Connect free-first learning, costs, transactions, runtime receipts, and reinvestment.",
      "required_controls": [
        "free_first_path",
        "price_capture",
        "discount_math",
        "commercial_rights_clearance",
        "transaction_receipt",
        "margin",
        "runtime_receipt",
        "community_reinvestment_state"
      ]
    }
  },
  "system_lanes": [
    "LEARN",
    "CREATE",
    "VERIFY",
    "PROVE",
    "PUBLISH",
    "MEASURE",
    "TRANSACT",
    "AUDIT",
    "REINVEST",
    "STAY"
  ],
  "coverage_formula": "valid_required_controls / applicable_required_controls",
  "coverage_target": 1.0,
  "coverage_rule": "A dimension can report 1.0 only when every applicable required control has an explicit PASS state; HOLD, UNKNOWN, NOT_OBSERVED, or CONFLICT never count as PASS.",
