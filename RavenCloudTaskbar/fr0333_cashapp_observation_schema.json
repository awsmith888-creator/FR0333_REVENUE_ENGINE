{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FR0333.REVENUE.AUDITANCE.CASHAPP.OBSERVATION.001",
  "title": "FR0333 Cash App Read-Only Observation Record",
  "version": "0.1.0",
  "state": "READ_ONLY_ADAPTER_NOT_PAYMENT_AUTHORITY",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "mode",
    "source_event_id",
    "source_record_type",
    "source_timestamp",
    "source_amount",
    "source_status",
    "source_parties",
    "source_fee",
    "source_reference",
    "source_document_hash",
    "source_evidence_class"
  ],
  "properties": {
    "provider": {"const": "CASH_APP"},
    "mode": {"const": "READ_ONLY"},
    "source_event_id": {"type": "string", "minLength": 1},
    "source_record_type": {"type": "string", "minLength": 1},
    "source_timestamp": {"type": "string", "minLength": 1},
    "source_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "source_status": {"type": "string", "minLength": 1},
    "source_parties": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "source_fee": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "source_reference": {"type": "string", "minLength": 1},
    "source_document_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_evidence_class": {"enum": ["PROVIDER_RECORD", "SCREENSHOT", "USER_ASSERTED", "OTHER"]}
  },
  "output_contract": [
    "NORMALIZED_RUNTIME_EVENT",
    "PROVIDER_EVIDENCE_POINTER",
    "OBSERVATION_RECEIPT_HASH"
  ],
  "hard_gates": [
    "CASHAPP_SCREENSHOT_ONLY_NE_PROVIDER_RECORD_VERIFIED",
    "PROVIDER_RECORD_NE_SETTLED",
    "SETTLED_NE_RECONCILED",
    "OBSERVED_LIVE_NE_AUTHORIZED_MONEY_MOVEMENT",
    "PROVIDER_RECORD_NE_FDIC_INSURED",
    "PROVIDER_RECORD_NE_BOND_PROTECTED",
    "PROVIDER_RECORD_NE_REVENUE_TRUE",
    "PROVIDER_RECORD_NE_VALUE_REALIZED",
    "ABSENT_EXPOSURE_NE_ZERO_EXPOSURE",
    "ABSENT_RESERVE_NE_ZERO_RESERVE"
  ]
}
