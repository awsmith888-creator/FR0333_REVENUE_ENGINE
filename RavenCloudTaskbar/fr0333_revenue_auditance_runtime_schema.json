{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FR0333.REVENUE.AUDITANCE.RUNTIME.001",
  "title": "FR0333 Revenue Auditance Money Event",
  "version": "0.3.0",
  "state": "SIMULATION_SCHEMA_NOT_LIVE_MONEY_MOVEMENT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id", "event_class", "source_event_id", "contract_id", "contract_version",
    "authority_id", "source_rail", "source_account_class", "amount_gross", "fee_amount",
    "refund_exposure", "chargeback_exposure", "reserve_amount", "amount_net",
    "legal_owner_before", "legal_owner_after", "custodian", "destination",
    "settlement_status", "reconciliation_status", "bond_status", "insurance_status",
    "fdic_status", "encumbrance_status", "value_realized", "requested_at", "observed_at",
    "settled_at", "reconciled_at", "source_evidence", "receipt_hash"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_class": {"enum": ["SYNTHETIC", "OBSERVED_LIVE"]},
    "source_event_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "authority_id": {"type": "string", "minLength": 1},
    "source_rail": {"type": "string", "minLength": 1},
    "source_account_class": {"type": "string", "minLength": 1},
    "amount_gross": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "fee_amount": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"},
    "refund_exposure": {"anyOf": [{"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, {"const": "UNKNOWN"}]},
    "chargeback_exposure": {"anyOf": [{"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, {"const": "UNKNOWN"}]},
    "reserve_amount": {"anyOf": [{"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, {"const": "UNKNOWN"}]},
    "amount_net": {"anyOf": [{"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, {"const": "UNKNOWN"}]},
    "legal_owner_before": {"type": "string", "minLength": 1},
    "legal_owner_after": {"type": "string", "minLength": 1},
    "custodian": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "settlement_status": {"enum": ["REQUESTED", "AVAILABLE", "PENDING", "SETTLED", "FAILED", "UNKNOWN"]},
    "reconciliation_status": {"enum": ["NOT_RECONCILED", "RECONCILED", "FAILED", "UNKNOWN"]},
    "bond_status": {"enum": ["NOT_APPLICABLE", "NOT_VERIFIED", "COVERED", "NOT_COVERED", "UNKNOWN"]},
    "insurance_status": {"enum": ["NOT_APPLICABLE", "NOT_VERIFIED", "COVERED", "NOT_COVERED", "UNKNOWN"]},
    "fdic_status": {"enum": ["NOT_APPLICABLE", "NOT_VERIFIED", "ELIGIBLE_PASS_THROUGH", "INSURED", "NOT_INSURED", "UNKNOWN"]},
    "encumbrance_status": {"enum": ["UNENCUMBERED", "ENCUMBERED", "NOT_VERIFIED", "UNKNOWN"]},
    "value_realized": {"anyOf": [{"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"}, {"const": "UNKNOWN"}]},
    "requested_at": {"type": "string", "minLength": 1},
    "observed_at": {"type": ["string", "null"]},
    "settled_at": {"type": ["string", "null"]},
    "reconciled_at": {"type": ["string", "null"]},
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "evidence_class", "pointer"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "evidence_class": {"enum": ["SYNTHETIC_FIXTURE", "PROVIDER_RECORD", "BANK_RECORD", "CONTRACT", "REGULATOR", "USER_ASSERTED", "OTHER"]},
          "pointer": {"type": "string", "minLength": 1}
        }
      }
    },
    "receipt_hash": {"type": ["string", "null"]}
  },
  "hard_gates": [
    "MONEY_IN_NE_REVENUE",
    "AVAILABLE_NE_SETTLED",
    "SETTLED_NE_RECONCILED",
    "RECONCILED_NE_PROTECTED",
    "PROTECTED_NE_INSURED",
    "TRANSACTION_VALUE_NE_REALIZED_FR0333_VALUE",
    "UNKNOWN_PROTECTION_STATE_EQ_UNKNOWN_NOT_SAFE",
    "UNVERIFIED_EXPOSURE_NE_ZERO_EXPOSURE",
    "UNVERIFIED_MONEY_STATE_NE_ZERO",
    "SYNTHETIC_NE_LIVE_FINANCIAL_EXECUTION"
  ]
}
