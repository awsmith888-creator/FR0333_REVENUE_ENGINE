{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fr0333.local/schemas/observation_record.schema.json",
  "title": "FR0333 RSI Observation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "timestamp",
    "topic",
    "sources",
    "claims",
    "notes"
  ],
  "properties": {
    "record_id": {"const": "FR0333.RSI.OBSERVATION.PIPELINE.0001"},
    "timestamp": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "topic": {"const": "bounded_recursive_self_improvement"},
    "sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 2,
      "uniqueItems": true
    },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["T.20", "U.21", "F.6"]}
    },
    "notes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
