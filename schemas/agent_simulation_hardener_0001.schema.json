{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fr0333.local/schemas/agent_simulation_hardener_0001.schema.json",
  "title": "FR0333 Agent Simulation Hardener 0001",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulation_id",
    "task",
    "source_snapshot_hash",
    "tool_manifest",
    "mutation_policy",
    "expected_state",
    "forbidden_state",
    "observed_state",
    "interrupt_points",
    "failure_taxonomy",
    "claim_receipts",
    "output_hash",
    "telemetry_metrics",
    "legacy_baseline",
    "humanlock",
    "safety_coverage",
    "promotion_state"
  ],
  "properties": {
    "simulation_id": {"const": "FR0333.AGENT.SIMULATION.HARDENER.0001"},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "input_hash", "mode"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Z0-9._-]+$"},
        "input_hash": {"$ref": "#/$defs/hash"},
        "mode": {"enum": ["SIMULATION", "REPLAY", "FAILURE_INJECTION"]}
      }
    },
    "source_snapshot_hash": {"$ref": "#/$defs/hash"},
    "tool_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "signature", "access"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "signature": {"type": "string", "minLength": 1},
          "access": {"enum": ["READ", "WRITE", "EXECUTE"]}
        }
      }
    },
    "mutation_policy": {"enum": ["READ_ONLY", "WRITE_ALLOWED", "HUMAN_APPROVAL"]},
    "expected_state": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_state": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observed_state": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "interrupt_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "humanlock_required", "status"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "humanlock_required": {"type": "boolean"},
          "status": {"enum": ["ARMED", "PASSED", "HELD", "NOT_REACHED"]}
        }
      }
    },
    "failure_taxonomy": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["HALLUCINATION", "SOURCE_DRIFT", "UNSAFE_MUTATION", "COUNT_DRIFT", "LEAK", "IDENTITY_COLLAPSE", "CAUSAL_OVERREACH"]}
    },
    "claim_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "claim_body", "verification_token", "evidence_relation", "state"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "claim_body": {"type": "string", "minLength": 1},
          "verification_token": {"type": "string", "minLength": 1},
          "evidence_relation": {"enum": ["OBSERVED", "CORRELATED", "CAUSAL", "INSTITUTIONAL_RECORD"]},
          "state": {"enum": ["T.20", "U.21", "F.6"]}
        }
      }
    },
    "output_hash": {"$ref": "#/$defs/hash"},
    "telemetry_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "input_tokens", "output_tokens", "cost_usd", "tool_calls"],
      "properties": {
        "latency_ms": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "legacy_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "accuracy_score", "latency_ms", "cost_usd"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "accuracy_score": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_ms": {"type": "integer", "minimum": 0},
        "cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "humanlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "correctable", "interruptible"],
      "properties": {
        "active": {"const": true},
        "correctable": {"const": true},
        "interruptible": {"const": true}
      }
    },
    "safety_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_delta", "coverage_level", "gate_rule"],
      "properties": {
        "capability_delta": {"type": "number", "minimum": 0},
        "coverage_level": {"type": "number", "minimum": 0},
        "gate_rule": {"const": "CAPABILITY.DELTA>SAFETY.COVERAGE=>HOLD"}
      }
    },
    "promotion_state": {"const": "U.21.UNVERIFIED"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256_[0-9a-f]{64}$"}
  }
}
